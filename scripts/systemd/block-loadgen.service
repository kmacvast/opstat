[Unit]
Description=VAST NVMe-oTCP block protocol load generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/vastdata/kmactools/scripts/block-loadgen.sh
WorkingDirectory=/tmp
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
