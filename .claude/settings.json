{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",

      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(awk *)",
      "Bash(sed *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git stash list *)",
      "Bash(git worktree list *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",

      "Bash(git add *)",
      "Bash(git commit *)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",

      "Bash(./scripts/validate.sh)",
      "Bash(./scripts/validate.sh *)",
      "Bash(bash scripts/validate.sh *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(uv run --python 3.8 *)",
      "Bash(python3 tests/mock_vms.py *)",

      "Bash(python3 --version)",
      "Bash(python3 -c *)",
      "Bash(openssl version)",
      "Bash(./opstat --help)",
      "Bash(./opstat -V)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git revert*)",
      "Bash(git cherry-pick*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(gh pr*)",
      "Bash(gh release*)",
      "Bash(gh api*)",
      "Bash(gh repo*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push -d*)",
      "Bash(git push --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",

      "Bash(curl -X DELETE*)",
      "Bash(curl -X POST*)",
      "Bash(curl -X PUT*)",
      "Bash(curl -X PATCH*)",
      "Bash(curl --request DELETE*)",
      "Bash(curl --request POST*)",
      "Bash(curl --request PUT*)",
      "Bash(curl --request PATCH*)",
      "Bash(curl -d *)",
      "Bash(curl --data*)",

      "Bash(cat *.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cp *.env*)",
      "Bash(cp *.pem*)",
      "Bash(cp *.key*)",
      "Bash(cp * /*)",
      "Bash(mv * /*)",
      "Bash(cp * ~/*)",
      "Bash(mv * ~/*)",
      "Bash(sed -i* /*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
